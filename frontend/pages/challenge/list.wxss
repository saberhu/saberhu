


/* ============================================================
   约战广场样式
   ============================================================ */

/* 筛选Tab */
.filter-tabs {
  display: flex;
  background: #fff;
  padding: 10px 16px;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.filter-tab {
  padding: 6px 16px;
  font-size: 14px;
  color: var(--text-secondary);
  margin-right: 8px;
  border-radius: 16px;
  background: var(--bg-color);
}

.filter-tab.active {
  color: #fff;
  background: var(--primary);
  font-weight: 500;
}

/* 列表区域 */
.list-wrap {
  padding: 12px 0;
}

/* 约战卡片 */
.challenge-card {
  margin-bottom: 10px;
}

.challenge-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.challenge-user {
  display: flex;
  align-items: center;
}

.challenge-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  margin-right: 10px;
}

.challenge-user-info {
  display: flex;
  flex-direction: column;
}

.challenge-nickname {
  font-size: 15px;
  font-weight: 500;
}

.challenge-level {
  margin-top: 2px;
  align-self: flex-start;
}

/* 标签行 */
.challenge-tags {
  display: flex;
  margin-bottom: 8px;
}

.challenge-tags .tag {
  margin-right: 8px;
}

/* 信息行 */
.challenge-info {
  display: flex;
  flex-direction: column;
  margin-bottom: 8px;
}

.info-item {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 2px;
}

/* 底部 */
.challenge-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8px;
  border-top: 1px solid var(--border-color);
}

.challenge-remark {
  font-size: 12px;
  color: var(--text-color);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.challenge-signup {
  font-size: 12px;
  color: var(--text-secondary);
  flex-shrink: 0;
}

/* 悬浮按钮 */
.float-btn {
  position: fixed;
  right: 24px;
  bottom: 100px;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(245, 124, 0, 0.4);
  z-index: 100;
}

.float-btn-icon {
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

/* 空状态图标 */
.empty-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 12px;
}



