/* ============================================================
   约战广场样式
   ============================================================ */

.page {
  background: var(--bg-color);
  min-height: 100vh;
}

/* 筛选Tab */
.filter-tabs {
  display: flex;
  padding: 10px 16px;
  background: #fff;
  gap: 8px;
  border-bottom: 1px solid var(--border-color);
}

.filter-tab {
  padding: 6px 16px;
  font-size: 13px;
  color: var(--text-secondary);
  border-radius: 16px;
  background: var(--bg-color);
}

.filter-tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

/* 列表 */
.list-wrap {
  padding: 12px 0;
}

.challenge-card {
  margin-bottom: 10px;
}

.challenge-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.challenge-user {
  display: flex;
  align-items: center;
}

.challenge-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  margin-right: 8px;
  flex-shrink: 0;
}

.challenge-user-info {
  display: flex;
  flex-direction: column;
}

.challenge-nickname {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-color);
}

.challenge-level {
  font-size: 11px;
  color: var(--text-secondary);
}

.challenge-tags {
  display: flex;
  gap: 6px;
  margin-bottom: 6px;
}

.challenge-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6px;
}

.info-item {
  font-size: 12px;
  color: var(--text-secondary);
}

.challenge-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.challenge-remark {
  font-size: 12px;
  color: var(--text-color);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.challenge-signup {
  font-size: 12px;
  color: var(--text-secondary);
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-secondary);
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.empty-icon {
  font-size: 40px;
}

/* 悬浮按钮 */
.float-btn {
  position: fixed;
  right: 20px;
  bottom: 30px;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(245, 124, 0, 0.4);
  z-index: 10;
}

.float-btn-icon {
  font-size: 28px;
  line-height: 1;
}
