












/* 创建约战样式 */
.page {
  padding: 16px;
}

.form-group {
  margin-bottom: 16px;
}

.label {
  font-size: 14px;
  color: var(--text-color);
  display: block;
  margin-bottom: 6px;
  font-weight: bold;
}

.picker {
  background: #fff;
  border-radius: 4px;
  padding: 10px 12px;
  font-size: 14px;
  color: var(--text-color);
  border: 1px solid var(--border-color);
}

.input {
  background: #fff;
  border-radius: 4px;
  padding: 10px 12px;
  font-size: 14px;
  border: 1px solid var(--border-color);
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  background: #fff;
  border-radius: 4px;
  padding: 10px 12px;
  font-size: 14px;
  border: 1px solid var(--border-color);
  width: 100%;
  height: 80px;
  box-sizing: border-box;
}

.submit-btn {
  background: var(--theme-color);
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 12px;
  font-size: 16px;
  width: 100%;
  margin-top: 20px;
}












