










/* ============================================================
   发起约战样式
   ============================================================ */
.page {
  padding: 16px;
}

.form-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px 16px;
  box-shadow: var(--card-shadow);
}

.form-group {
  margin-bottom: 18px;
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 14px;
  color: var(--text-color);
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
}

.picker {
  background: var(--bg-color);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 14px;
  color: var(--text-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker.placeholder {
  color: var(--text-light);
}

.picker-arrow {
  width: 14px;
  height: 14px;
  vertical-align: middle;
}

.input {
  background: var(--bg-color);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
  border: none;
}

.textarea {
  background: var(--bg-color);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 14px;
  width: 100%;
  height: 80px;
  box-sizing: border-box;
  border: none;
}

.submit-btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 14px;
  font-size: 16px;
  width: 100%;
  margin-top: 24px;
  font-weight: 500;
}

.submit-btn[disabled] {
  opacity: 0.6;
}






