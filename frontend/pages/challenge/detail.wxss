














/* 约战详情样式 */
.page {
  padding: 16px;
}

.detail-card {
  background: #fff;
  border-radius: 8px;
  padding: 16px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border-color);
}

.ball-type {
  font-size: 18px;
  font-weight: bold;
}

.status {
  font-size: 13px;
  padding: 3px 10px;
  border-radius: 12px;
  background: #e8f5e9;
  color: var(--theme-color);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
}

.info-label {
  font-size: 14px;
  color: var(--text-secondary);
}

.info-value {
  font-size: 14px;
  color: var(--text-color);
}

.signup-btn {
  background: var(--theme-color);
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 12px;
  font-size: 16px;
  width: 100%;
  margin-top: 20px;
}

.loading-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-secondary);
}














