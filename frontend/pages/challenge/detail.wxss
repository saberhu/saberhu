/* ============================================================
   约战详情样式
   ============================================================ */
.page {
  padding: 16px;
  padding-bottom: 100px;
  background: var(--bg-color);
  min-height: 100vh;
}

.detail-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--card-shadow);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ball-type {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-color);
}

.challenge-id {
  font-size: 12px;
  color: var(--text-light);
}

/* 发起人信息 */
.initiator-section {
  display: flex;
  align-items: center;
  padding: 12px;
  background: var(--bg-color);
  border-radius: 10px;
  margin-bottom: 12px;
}

.initiator-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-right: 12px;
  flex-shrink: 0;
}

.initiator-info {
  display: flex;
  flex-direction: column;
}

.initiator-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-color);
}

.initiator-level {
  font-size: 11px;
  margin-top: 2px;
}

/* 详细信息 */
.info-list {
  margin-bottom: 12px;
}

.info-row {
  display: flex;
  padding: 8px 0;
  border-bottom: 1px solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 13px;
  color: var(--text-secondary);
  width: 80px;
  flex-shrink: 0;
}

.info-value {
  font-size: 13px;
  color: var(--text-color);
  flex: 1;
}

/* 比分 */
.score-section {
  padding-top: 12px;
  border-top: 1px solid var(--border-color);
}

.score-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-color);
  display: block;
  text-align: center;
  margin-bottom: 8px;
}

.score-display {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
}

.score-side {
  text-align: center;
}

.score-name {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4px;
}

.score-num {
  font-size: 32px;
  font-weight: bold;
  color: var(--primary);
}

.score-vs {
  font-size: 20px;
  color: var(--text-light);
}

/* 报名列表 */
.section {
  margin-bottom: 12px;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-color);
  display: block;
  margin-bottom: 8px;
}

.signup-item {
  background: #fff;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 8px;
  box-shadow: var(--card-shadow);
}

.signup-user {
  display: flex;
  align-items: center;
}

.signup-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary-light);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  margin-right: 10px;
  flex-shrink: 0;
}

.signup-name {
  flex: 1;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-color);
}

.signup-status {
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 10px;
}

.signup-status.approved {
  background: #e8f5e9;
  color: #2e7d32;
}

.signup-status.pending {
  background: #fff3e0;
  color: var(--accent);
}

.signup-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--border-color);
}

.action-btn {
  flex: 1;
  padding: 8px;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
}

.action-btn.confirm {
  background: var(--primary);
  color: #fff;
}

.action-btn.reject {
  background: #f5f5f5;
  color: var(--text-secondary);
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid var(--border-color);
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.action-btn-primary {
  width: 100%;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 14px;
  font-size: 16px;
  font-weight: 500;
}

.action-btn-accent {
  width: 100%;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 14px;
  font-size: 16px;
  font-weight: 500;
}

.action-btn-danger {
  width: 100%;
  background: #fff;
  color: var(--danger);
  border: 1px solid var(--danger);
  border-radius: 8px;
  padding: 14px;
  font-size: 16px;
}

.status-text {
  display: block;
  text-align: center;
  color: var(--text-secondary);
  font-size: 14px;
  padding: 14px 0;
}
