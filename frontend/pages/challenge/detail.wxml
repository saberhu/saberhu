<!-- ============================================================
     约战详情 - 信息展示、报名/取消、确认/拒绝、记分入口
     ============================================================ -->
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">加载中...</view>

  <block wx:else>
    <!-- 约战信息卡片 -->
    <view class="detail-card">
      <view class="card-header">
        <view class="header-left">
          <text class="ball-type">{{challenge.ballType === 1 ? '中式八球' : challenge.ballType === 2 ? '斯诺克' : '九球'}}</text>
          <text class="tag {{challenge.status === 0 ? 'tag-pending' : challenge.status === 1 ? 'tag-active' : 'tag-done'}}">
            {{challenge.status === 0 ? '待应战' : challenge.status === 1 ? '进行中' : '已结束'}}
          </text>
        </view>
        <text class="challenge-id">#{{challenge.id}}</text>
      </view>

      <!-- 发起人信息 -->
      <view class="initiator-section">
        <view class="initiator-avatar">{{challenge.initiatorName ? challenge.initiatorName[0] : '?'}}</view>
        <view class="initiator-info">
          <text class="initiator-name">{{challenge.initiatorName || '未知'}}</text>
          <text class="initiator-level level-tag">{{getLevelName(challenge.initiatorLevelScore)}}</text>
        </view>
      </view>

      <!-- 详细信息 -->
      <view class="info-list">
        <view class="info-row">
          <text class="info-label">📍 球房</text>
          <text class="info-value">{{challenge.ballroomName || '待定'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">🕐 开始时间</text>
          <text class="info-value">{{formatTime(challenge.startTime)}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">📋 赛制</text>
          <text class="info-value">{{challenge.formatType === 1 ? '局数制' : '时间制'}} {{challenge.formatValue}}{{challenge.formatType === 1 ? '局' : '分钟'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">👥 人数</text>
          <text class="info-value">{{challenge.signupCount || 1}}/{{challenge.maxPlayers}}人</text>
        </view>
        <view class="info-row" wx:if="{{challenge.remark}}">
          <text class="info-label">📝 备注</text>
          <text class="info-value">{{challenge.remark}}</text>
        </view>
      </view>

      <!-- 比分 -->
      <view class="score-section" wx:if="{{challenge.status > 0 && challenge.scoreInitiator !== null && challenge.scoreOpponent !== null}}">
        <text class="score-title">比分</text>
        <view class="score-display">
          <view class="score-side">
            <text class="score-name">{{challenge.initiatorName || '发起人'}}</text>
            <text class="score-num">{{challenge.scoreInitiator}}</text>
          </view>
          <text class="score-vs">:</text>
          <view class="score-side">
            <text class="score-name">{{challenge.opponentName || '对手'}}</text>
            <text class="score-num">{{challenge.scoreOpponent}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 报名列表 -->
    <view class="section" wx:if="{{signups.length > 0}}">
      <text class="section-title">报名列表</text>
      <view wx:for="{{signups}}" wx:key="signupId" class="signup-item">
        <view class="signup-user">
          <view class="signup-avatar">{{item.nickname ? item.nickname[0] : '?'}}</view>
          <text class="signup-name">{{item.nickname || '用户'}}</text>
          <text class="signup-status {{item.status === 1 ? 'approved' : 'pending'}}">
            {{item.status === 1 ? '已确认' : '待确认'}}
          </text>
        </view>
        <view class="signup-actions" wx:if="{{isInitiator && item.status === 0}}">
          <button class="action-btn confirm" bindtap="confirmSignup" data-id="{{item.signupId}}">确认</button>
          <button class="action-btn reject" bindtap="rejectSignup" data-id="{{item.signupId}}">拒绝</button>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <block wx:if="{{challenge.status === 0}}">
        <button class="action-btn-primary" wx:if="{{!isInitiator && !hasSigned}}" bindtap="signup">报名参与</button>
        <button class="action-btn-danger" wx:if="{{!isInitiator && hasSigned}}" bindtap="cancelSignup">取消报名</button>
        <button class="action-btn-danger" wx:if="{{isInitiator}}" bindtap="cancelChallenge">取消约战</button>
      </block>

      <block wx:if="{{challenge.status === 1}}">
        <button class="action-btn-accent" wx:if="{{isInitiator}}" bindtap="goScore">进入记分</button>
        <button class="action-btn-primary" wx:if="{{!isInitiator && hasSigned}}" bindtap="goScore">查看比分</button>
      </block>

      <block wx:if="{{challenge.status === 2}}">
        <text class="status-text">本场约战已结束</text>
      </block>
    </view>
  </block>
</view>
