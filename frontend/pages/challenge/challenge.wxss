









/* 约战列表样式 */
.page {
  padding: 12px 16px;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.title {
  font-size: 18px;
  font-weight: bold;
}

.create-btn {
  background: var(--theme-color);
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 13px;
  padding: 6px 14px;
}

.challenge-card {
  background: #fff;
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 10px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.ball-type {
  font-size: 15px;
  font-weight: bold;
}

.status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 10px;
}

.status.pending {
  background: #e8f5e9;
  color: var(--theme-color);
}

.status.active {
  background: #fff3e0;
  color: #f57c00;
}

.status.done {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.start-time {
  font-size: 13px;
  color: var(--text-secondary);
  display: block;
}

.remark {
  font-size: 13px;
  color: var(--text-color);
  margin-top: 4px;
  display: block;
}








