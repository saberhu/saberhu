/* 约战列表样式 */
.page {
  padding: 12px 16px;
  background: var(--bg-color);
  min-height: 100vh;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-color);
}

.create-btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  padding: 8px 16px;
  font-weight: 500;
}

.challenge-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: var(--card-shadow);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.ball-type {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-color);
}

.status {
  font-size: 12px;
  padding: 2px 10px;
  border-radius: 10px;
  font-weight: 500;
}

.status.pending {
  background: #e3f2fd;
  color: #1565c0;
}

.status.active {
  background: #fff3e0;
  color: var(--accent);
}

.status.done {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.start-time {
  font-size: 13px;
  color: var(--text-secondary);
  display: block;
}

.remark {
  font-size: 13px;
  color: var(--text-color);
  margin-top: 4px;
  display: block;
}
