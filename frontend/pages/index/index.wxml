



<!-- ============================================================
     首页 - 搜索栏、轮播图、快捷入口、约战列表、球房推荐
     ============================================================ -->
<view class="page">

  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索球房、约战..." bindconfirm="onSearch" confirm-type="search" />
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{4000}}" circular="{{true}}">
    <swiper-item wx:for="{{swiperList}}" wx:key="id">
      <image src="{{item.image}}" class="swiper-image" mode="scaleToFill" />
    </swiper-item>
  </swiper>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goCreateChallenge">
      <view class="action-icon-wrap accent">
        <text class="action-icon">⚡</text>
      </view>
      <text class="action-text">快速约战</text>
    </view>
    <view class="action-item" bindtap="goBallroomMap">
      <view class="action-icon-wrap primary">
        <text class="action-icon">🏠</text>
      </view>
      <text class="action-text">附近球房</text>
    </view>
    <view class="action-item" bindtap="goMyStats">
      <view class="action-icon-wrap success">
        <text class="action-icon">📊</text>
      </view>
      <text class="action-text">我的战绩</text>
    </view>
  </view>

  <!-- 附近正在约战 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🔥 附近正在约战</text>
      <text class="section-more" bindtap="goChallengeList">更多 <image src="/images/icons/arrow-right.svg" class="arrow-icon"/></text>
    </view>
    <view wx:if="{{challenges.length === 0}}" class="empty-state-small">暂无约战，快去发起吧</view>
    <view wx:for="{{challenges}}" wx:key="id" class="challenge-card" bindtap="goChallenge" data-id="{{item.id}}">
      <view class="challenge-top">
        <view class="challenge-user">
          <view class="challenge-avatar">{{item.initiatorName ? item.initiatorName[0] : '?'}}</view>
          <view class="challenge-user-info">
            <text class="challenge-nickname">{{item.initiatorName || '未知'}}</text>
            <text class="challenge-level">{{getLevelName(item.initiatorLevelScore || 0)}}</text>
          </view>
        </view>
        <text class="tag tag-pending">{{item.ballType === 1 ? '中式八球' : item.ballType === 2 ? '斯诺克' : '九球'}}</text>
      </view>
      <view class="challenge-mid">
        <text class="challenge-ballroom">📍 {{item.ballroomName || '待定'}}</text>
        <text class="challenge-time">🕐 {{formatTime(item.startTime)}}</text>
      </view>
      <view class="challenge-bottom">
        <text class="challenge-format">{{item.formatType === 1 ? '局数制' : '时间制'}} {{item.formatValue}}</text>
        <text class="challenge-signup-count">👥 {{item.signupCount || 0}}/{{item.maxPlayers || 2}}人</text>
      </view>
    </view>
  </view>

  <!-- 热门球房推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🏆 热门球房推荐</text>
      <text class="section-more" bindtap="goBallroomMap">更多 <image src="/images/icons/arrow-right.svg" class="arrow-icon"/></text>
    </view>
    <view wx:if="{{ballrooms.length === 0}}" class="empty-state-small">暂无球房数据</view>
    <view wx:for="{{ballrooms}}" wx:key="id" class="ballroom-card" bindtap="goBallroom" data-id="{{item.id}}">
      <view class="ballroom-top">
        <text class="ballroom-name">{{item.name}}</text>
        <text class="ballroom-rating">⭐ {{item.rating || 0}}</text>
      </view>
      <text class="ballroom-address">{{item.address}}</text>
      <view class="ballroom-bottom">
        <text class="ballroom-price">{{item.priceDesc || '暂无'}}</text>
        <text class="ballroom-hours">🕐 {{item.businessHours || '暂无'}}</text>
      </view>
    </view>
  </view>

</view>


