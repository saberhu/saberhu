





/* 首页样式 */
.page {
  padding-bottom: 20px;
}

.banner-img {
  width: 100%;
  height: 160px;
  background: var(--theme-color);
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 16px;
  background: #fff;
  margin: 12px 16px;
  border-radius: 8px;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 28px;
  margin-bottom: 4px;
}

.action-text {
  font-size: 12px;
  color: var(--text-color);
}

.section {
  margin: 12px 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
}

.section-more {
  font-size: 12px;
  color: var(--theme-color);
}

.ballroom-card,
.challenge-card {
  background: #fff;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 8px;
}

.ballroom-name {
  font-size: 15px;
  font-weight: bold;
  display: block;
}

.ballroom-address {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin: 4px 0;
}

.ballroom-info {
  display: flex;
  justify-content: space-between;
}

.ballroom-price {
  color: var(--theme-color);
  font-size: 13px;
}

.ballroom-rating {
  font-size: 12px;
}

.challenge-card {
  display: flex;
  justify-content: space-between;
}

.challenge-time {
  font-size: 13px;
}

.challenge-status {
  font-size: 12px;
  color: var(--theme-color);
}





