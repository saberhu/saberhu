




/* ============================================================
   首页样式 - 深蓝+橙色主题
   ============================================================ */

/* 搜索栏 */
.search-bar {
  padding: 10px 16px;
  background: var(--primary);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 8px 14px;
}

.search-icon {
  font-size: 16px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  color: #fff;
  placeholder-color: rgba(255, 255, 255, 0.6);
}

/* 轮播图 */
.swiper {
  width: 100%;
  height: 180px;
}

.swiper-image {
  width: 100%;
  height: 180px;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 16px;
  background: #fff;
  margin: -10px 16px 12px;
  border-radius: 12px;
  box-shadow: var(--card-shadow);
  position: relative;
  z-index: 2;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.action-icon-wrap.accent {
  background: #fff3e0;
}

.action-icon-wrap.primary {
  background: #e8eaf6;
}

.action-icon-wrap.success {
  background: #e8f5e9;
}

.action-icon {
  font-size: 22px;
}

.action-text {
  font-size: 12px;
  color: var(--text-color);
  font-weight: 500;
}

/* 区块标题 */
.section {
  margin: 16px 16px 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-color);
}

.section-more {
  font-size: 12px;
  color: var(--accent);
}

/* 空状态小 */
.empty-state-small {
  text-align: center;
  padding: 24px 0;
  color: var(--text-secondary);
  font-size: 13px;
  background: #fff;
  border-radius: 12px;
  margin-bottom: 10px;
}

/* 约战卡片 */
.challenge-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: var(--card-shadow);
}

.challenge-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.challenge-user {
  display: flex;
  align-items: center;
}

.challenge-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  margin-right: 8px;
}

.challenge-user-info {
  display: flex;
  flex-direction: column;
}

.challenge-nickname {
  font-size: 14px;
  font-weight: 500;
}

.challenge-level {
  font-size: 11px;
  color: var(--text-secondary);
}

.challenge-mid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6px;
}

.challenge-ballroom,
.challenge-time {
  font-size: 12px;
  color: var(--text-secondary);
}

.challenge-bottom {
  display: flex;
  justify-content: space-between;
}

.challenge-format {
  font-size: 12px;
  color: var(--primary);
  background: #e8eaf6;
  padding: 1px 8px;
  border-radius: 8px;
}

.challenge-signup-count {
  font-size: 12px;
  color: var(--text-secondary);
}

/* 球房卡片 */
.ballroom-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: var(--card-shadow);
}

.ballroom-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.ballroom-name {
  font-size: 15px;
  font-weight: 600;
}

.ballroom-rating {
  font-size: 13px;
  color: #f5a623;
}

.ballroom-address {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6px;
}

.ballroom-bottom {
  display: flex;
  justify-content: space-between;
}

.ballroom-price {
  color: var(--accent);
  font-size: 13px;
  font-weight: 500;
}

.ballroom-hours {
  font-size: 12px;
  color: var(--text-secondary);
}





