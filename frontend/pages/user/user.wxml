














<!-- 个人中心 -->
<view class="page">
  <view wx:if="{{!isLoggedIn}}" class="login-section">
    <view class="avatar-placeholder">👤</view>
    <text class="login-tip">点击登录使用完整功能</text>
    <button class="login-btn" bindtap="login">微信登录</button>
  </view>

  <block wx:else>
    <view class="user-card">
      <view class="avatar">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="level">段位积分：{{userInfo.levelScore}}</text>
      </view>
    </view>

    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{userInfo.wins || 0}}</text>
        <text class="stat-label">胜场</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{userInfo.losses || 0}}</text>
        <text class="stat-label">负场</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{userInfo.creditScore || 100}}</text>
        <text class="stat-label">信用分</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="goMyChallenges">
        <text>📋 我的约战</text>
        <text>&gt;</text>
      </view>
      <view class="menu-item" bindtap="goMyFavorites">
        <text>❤️ 我的收藏</text>
        <text>&gt;</text>
      </view>
    </view>
  </block>
</view>














