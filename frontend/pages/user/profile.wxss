/* ============================================================
   个人中心样式
   ============================================================ */

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, #1a2a4a 0%, #2a3f6a 100%);
  padding: 30px 20px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.user-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  border: 3px solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-nickname {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 4px;
}

.user-level {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.user-credit {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

/* 数据统计 */
.stats-card {
  display: flex;
  background: #fff;
  margin: -12px 16px 16px;
  border-radius: 12px;
  padding: 16px 0;
  box-shadow: var(--card-shadow);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1px solid var(--border-color);
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  font-size: 22px;
  font-weight: bold;
  color: var(--primary);
  display: block;
}

.stat-num.accent {
  color: var(--accent);
}

.stat-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}

/* Tab切换 */
.tabs {
  display: flex;
  margin: 0 16px 12px;
  background: #fff;
  border-radius: 10px;
  padding: 4px;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 14px;
  color: var(--text-secondary);
  border-radius: 8px;
}

.tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

/* Tab内容 */
.tab-content {
  padding: 0 16px;
}

.challenge-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.ball-type-tag {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-color);
}

.challenge-time {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 2px;
}

.challenge-ballroom {
  font-size: 12px;
  color: var(--text-light);
}
