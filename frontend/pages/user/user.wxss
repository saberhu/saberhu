/* 个人中心样式 */
.page {
  padding: 16px;
  background: var(--bg-color);
  min-height: 100vh;
}

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}

.avatar-placeholder {
  font-size: 60px;
  margin-bottom: 12px;
}

.login-tip {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 20px;
}

.login-btn {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 40px;
  font-size: 14px;
  font-weight: 500;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--card-shadow);
}

.avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  margin-right: 12px;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 18px;
  font-weight: 600;
  display: block;
  color: var(--text-color);
}

.level {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
  display: block;
}

.stats-card {
  display: flex;
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--card-shadow);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 22px;
  font-weight: bold;
  color: var(--primary);
  display: block;
}

.stat-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 4px;
  display: block;
}

.menu-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: var(--card-shadow);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 14px 16px;
  font-size: 14px;
  color: var(--text-color);
  border-bottom: 1px solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}
