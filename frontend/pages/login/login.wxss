

/* ============================================================
   模拟登录页样式
   ============================================================ */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  padding: 40px 20px;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32px;
}

.logo {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  margin-bottom: 16px;
  background: var(--accent);
}

.title {
  font-size: 24px;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 8px;
}

.subtitle {
  font-size: 14px;
  color: var(--text-light);
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.user-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  align-items: center;
  box-shadow: var(--card-shadow);
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 600;
  color: #fff;
  margin-right: 14px;
  flex-shrink: 0;
}

.avatar.c1 { background: #4A90D9; }
.avatar.c2 { background: #E67E22; }
.avatar.c3 { background: #2ECC71; }
.avatar.c4 { background: #E74C3C; }
.avatar.c5 { background: #9B59B6; }

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nickname {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-color);
}

.stats {
  font-size: 12px;
  color: var(--text-light);
}

.arrow {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

