<!-- ============================================================
     球房详情 - 轮播图、基本信息、导航、收藏、评价
     ============================================================ -->
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">加载中...</view>

  <block wx:else>
    <!-- 轮播图 -->
    <swiper class="swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}">
      <swiper-item wx:for="{{ballroom.images || ['/images/default-ballroom.png']}}" wx:key="index">
        <image class="swiper-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>

    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-header">
        <text class="ballroom-name">{{ballroom.name}}</text>
        <view class="header-actions">
          <view class="action-item {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
            <text>{{isFavorite ? '❤️' : '🤍'}}</text>
            <text class="action-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
          </view>
          <view class="action-item" bindtap="goCreateChallenge">
            <text>🎱</text>
            <text class="action-text">约战</text>
          </view>
        </view>
      </view>

      <view class="rating-row">
        <text class="rating-stars">{{'⭐'.repeat(Math.round(ballroom.rating || 0))}}</text>
        <text class="rating-num">{{ballroom.rating || 0}}分</text>
      </view>

      <view class="info-list">
        <view class="info-row">
          <text class="info-label">📍 地址</text>
          <text class="info-value">{{ballroom.address}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">📞 电话</text>
          <text class="info-value">{{ballroom.phone || '暂无'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">💰 价格</text>
          <text class="info-value accent">{{ballroom.priceDesc || '暂无'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">🕐 营业时间</text>
          <text class="info-value">{{ballroom.businessHours || '暂无'}}</text>
        </view>
      </view>

      <button class="nav-btn" bindtap="goNavigation">📱 一键导航</button>
    </view>

    <!-- 评价列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">用户评价</text>
        <text class="section-more" bindtap="showReview">写评价</text>
      </view>

      <view wx:if="{{reviews.length === 0}}" class="empty-state">暂无评价</view>

      <view wx:for="{{reviews}}" wx:key="id" class="review-item">
        <view class="review-user">
          <view class="review-avatar">{{item.userName ? item.userName[0] : '?'}}</view>
          <view class="review-user-info">
            <text class="review-name">{{item.userName || '用户'}}</text>
            <text class="review-stars">{{'⭐'.repeat(item.rating || 0)}}</text>
          </view>
          <text class="review-time">{{item.createTime ? item.createTime.substring(0, 10) : ''}}</text>
        </view>
        <text class="review-content">{{item.content}}</text>
      </view>
    </view>

    <!-- 评价弹窗 -->
    <view class="modal-overlay" wx:if="{{showReviewForm}}" bindtap="hideReview">
      <view class="modal-content" catchtap>
        <text class="modal-title">写评价</text>
        <view class="rating-select">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:key="index"
            class="star {{item <= reviewRating ? 'active' : ''}}"
            bindtap="onRatingChange"
            data-rating="{{item}}"
          >{{item <= reviewRating ? '⭐' : '☆'}}</text>
        </view>
        <textarea class="review-textarea" value="{{reviewContent}}" bindinput="onReviewInput" placeholder="分享你的体验..." />
        <view class="modal-actions">
          <button class="modal-btn cancel" bindtap="hideReview">取消</button>
          <button class="modal-btn submit" bindtap="submitReview">提交</button>
        </view>
      </view>
    </view>
  </block>
</view>
