








/* 球房详情样式 */
.page {
  padding-bottom: 80px;
}

.detail-card {
  background: #fff;
  padding: 16px;
  margin: 12px 16px;
  border-radius: 8px;
}

.name {
  font-size: 20px;
  font-weight: bold;
  display: block;
  margin-bottom: 10px;
}

.address,
.phone,
.hours,
.price {
  display: block;
  font-size: 14px;
  color: var(--text-color);
  margin-bottom: 6px;
}

.rating-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
  font-size: 14px;
}

.rating-count {
  color: var(--text-secondary);
}

.action-bar {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid var(--border-color);
}

.btn-favorite {
  flex: 1;
  margin-right: 8px;
  background: #f5f5f5;
  border: none;
  border-radius: 4px;
  font-size: 14px;
}

.btn-challenge {
  flex: 2;
  background: var(--theme-color);
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 14px;
}

.section {
  margin: 12px 16px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  display: block;
  margin-bottom: 8px;
}

.review-item {
  background: #fff;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 8px;
}

.review-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4px;
}

.review-user {
  font-size: 13px;
  color: var(--text-secondary);
}

.review-rating {
  font-size: 13px;
  color: #f5a623;
}

.review-content {
  font-size: 14px;
  color: var(--text-color);
}

.loading-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-secondary);
}







