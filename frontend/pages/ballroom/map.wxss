/* ============================================================
   球房地图样式
   ============================================================ */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  background: var(--primary);
  gap: 10px;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 8px 14px;
}

.search-icon {
  font-size: 16px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  color: #fff;
  placeholder-color: rgba(255, 255, 255, 0.6);
}

.switch-btn {
  font-size: 14px;
  color: #fff;
  padding: 8px 14px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16px;
  flex-shrink: 0;
}

/* 地图 */
.map-wrap {
  width: 100%;
  height: calc(100vh - 100px);
}

.map {
  width: 100%;
  height: 100%;
}

/* 列表 */
.list-wrap {
  padding: 12px 0;
}

.ballroom-card {
  margin-bottom: 10px;
}

.ballroom-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.ballroom-name {
  font-size: 15px;
  font-weight: 600;
}

.ballroom-rating {
  font-size: 13px;
  color: #f5a623;
}

.ballroom-address {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6px;
}

.ballroom-bottom {
  display: flex;
  justify-content: space-between;
}

.ballroom-price {
  color: var(--accent);
  font-size: 13px;
  font-weight: 500;
}

.ballroom-distance {
  font-size: 12px;
  color: var(--primary);
}
