/* 球房列表样式 */
.page {
  padding: 12px 16px;
  min-height: 100vh;
  background: var(--bg-color);
}

.ballroom-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--card-shadow);
}

.ballroom-card:active {
  opacity: 0.9;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.name {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-color);
}

.rating {
  font-size: 12px;
  color: #f5a623;
  background: #fff8e1;
  padding: 2px 8px;
  border-radius: 10px;
}

.address {
  font-size: 13px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 10px;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid var(--border-color);
}

.price {
  color: var(--accent);
  font-size: 14px;
  font-weight: 500;
}

.hours {
  font-size: 12px;
  color: var(--text-secondary);
}
