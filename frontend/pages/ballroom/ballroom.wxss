/* 球房列表样式 */
.page {
  padding: 12px 16px;
  min-height: 100vh;
  background: #f5f5f5;
}

.ballroom-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: box-shadow 0.2s;
}

.ballroom-card:active {
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.name {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.rating {
  font-size: 13px;
  color: #f5a623;
  background: #fff8e1;
  padding: 2px 8px;
  border-radius: 10px;
}

.address {
  font-size: 13px;
  color: #999;
  display: block;
  margin-bottom: 10px;
  padding-left: 2px;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid #f0f0f0;
}

.price {
  color: #e74c3c;
  font-size: 14px;
  font-weight: 500;
}

.hours {
  font-size: 12px;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #999;
  font-size: 14px;
}

.loading-state {
  text-align: center;
  padding: 20px;
  color: #999;
  font-size: 13px;
}

.load-more {
  text-align: center;
  padding: 16px;
  color: #999;
  font-size: 13px;
}
