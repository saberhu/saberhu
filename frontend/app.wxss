/* ============================================================
   阜阳台球约战小程序 - 全局样式
   主色调：深蓝 #1a2a4a + 橙色 #f57c00 点缀
   ============================================================ */

/** 主题色变量 */
page {
  --primary: #1a2a4a;
  --primary-light: #2a3f6a;
  --accent: #f57c00;
  --accent-light: #ffa040;
  --bg-color: #f5f6f8;
  --text-color: #333;
  --text-secondary: #999;
  --text-light: #bbb;
  --border-color: #eee;
  --card-shadow: 0 2px 8px rgba(26, 42, 74, 0.08);
  --success: #4caf50;
  --danger: #f44336;

  background-color: var(--bg-color);
  color: var(--text-color);
  font-size: 14px;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

/** 页面通用容器 */
.page {
  padding: 0 0 20px 0;
  min-height: 100vh;
  background: var(--bg-color);
}

/** 卡片容器 */
.card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin: 12px 16px;
  box-shadow: var(--card-shadow);
}

/** 按钮基础样式 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 15px;
  text-align: center;
  font-weight: 500;
}

.btn-accent {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 15px;
  text-align: center;
  font-weight: 500;
}

/** 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-secondary);
  font-size: 14px;
}

/** 加载状态 */
.loading-state {
  text-align: center;
  padding: 30px 20px;
  color: var(--text-secondary);
  font-size: 13px;
}

/** 列表卡片通用样式 */
.list-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin: 0 16px 10px;
  box-shadow: var(--card-shadow);
}

/** 标签样式 */
.tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 500;
}

.tag-pending {
  background: #e3f2fd;
  color: #1565c0;
}

.tag-active {
  background: #fff3e0;
  color: var(--accent);
}

.tag-done {
  background: #f5f5f5;
  color: var(--text-secondary);
}

/** 段位标签 */
.level-tag {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 8px;
  font-size: 11px;
  background: #e8eaf6;
  color: var(--primary);
}
